# ───────── Aurora VIII · API y worker ─────────
# Copia este archivo a .env (desarrollo) o define las variables en Render (producción).

ENVIRONMENT=dev                       # dev | test | prod
LOG_LEVEL=INFO

# Supabase → Connect → "Session pooler" (IPv4, puerto 5432). Codifica caracteres especiales de la contraseña.
DATABASE_URL=postgresql://aurora:aurora@localhost:5432/aurora
# DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Frontend(s) autorizados (coma). Previews de Vercel opcionales por expresión regular.
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGIN_REGEX=https://aurora-viii-.*\.vercel\.app

# Autenticación: local (desarrollo) | supabase (producción)
AUTH_MODE=local
SUPABASE_URL=                          # https://TU_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=                   # solo si tu proyecto aún firma con el secreto HS256 legado
BOOTSTRAP_ADMIN_EMAILS=                # tu correo: será Administrador al primer ingreso

# Almacenamiento de datasets y modelos: local | supabase (obligatorio en Render: su disco es efímero)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./.storage
STORAGE_BUCKET=aurora-viii
SUPABASE_SECRET_KEY=                   # sb_secret_... (o SUPABASE_SERVICE_ROLE_KEY legada). NUNCA en el frontend.

# Worker
RUN_WORKER_IN_PROCESS=false            # true = la API también entrena (requiere TensorFlow y ≥ 2 GB RAM)
WORKER_POLL_SECONDS=1.5

# Límites por defecto (editables luego en Administración)
MAX_EPOCHS=200
MAX_UPLOAD_MB=10
MAX_CONCURRENT_JOBS_PER_USER=2
JOB_TIMEOUT_SECONDS=900
